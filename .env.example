# Copy to .env.local (or run `npx vercel env pull .env.local`). Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=
DATABASE_URL=
# Issue 004: public AI answers stay off until usage enforcement is verified. Set to "true" to enable.
AI_ANSWERS_ENABLED=
# Optional bounds (defaults in src/lib/limits.ts): MAX_QUESTION_CHARS, MAX_ANSWER_CHARS, MAX_ANSWER_TOKENS,
# MODEL_TIMEOUT_MS, CONTEXT_TURNS, AI_SESSION_LIMIT (50), AI_DAILY_LIMIT (500, per UTC day).
